#!/usr/bin/env bash

update() {
    local bot_retorno
    if [[ ! -x /usr/local/bin/telebotgen-update ]]; then
        bot_retorno="$LINE\nEl actualizador no está instalado. Ejecuta confbot.sh desde el VPS.\n$LINE"
        msj_fun
        return 1
    fi

    bot_retorno="$LINE\nActualización iniciada. El bot se reiniciará automáticamente.\n$LINE"
    msj_fun
    systemd-run --quiet --collect \
        --unit="telebotgen-update-$(date +%s)" \
        /usr/local/bin/telebotgen-update >/dev/null 2>&1 || {
        bot_retorno="$LINE\nNo se pudo iniciar la actualización. Revisa systemd y journalctl.\n$LINE"
        msj_fun
        return 1
    }
}
