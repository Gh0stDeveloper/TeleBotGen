#!/usr/bin/env bash

infosys_src() {
    local os_name kernel uptime_text memory disk api bot_state
    os_name="$(. /etc/os-release 2>/dev/null; printf '%s' "${PRETTY_NAME:-desconocido}")"
    kernel="$(uname -r)"
    uptime_text="$(uptime -p 2>/dev/null || true)"
    memory="$(free -h | awk '/^Mem:/ {print $3 "/" $2}')"
    disk="$(df -h / | awk 'NR==2 {print $3 "/" $2 " (" $5 ")"}')"
    api='OFFLINE'; license_api_health >/dev/null 2>&1 && api='ONLINE'
    bot_state="$(systemctl is-active telebotgen.service 2>/dev/null || true)"

    bot_retorno="<b>ESTADO DE LA VPS</b>\n$LINE\n"
    bot_retorno+="Sistema: <code>$(html_escape "$os_name")</code>\n"
    bot_retorno+="Kernel: <code>$(html_escape "$kernel")</code>\n"
    bot_retorno+="Uptime: <code>$(html_escape "$uptime_text")</code>\n"
    bot_retorno+="RAM: <code>$(html_escape "$memory")</code>\n"
    bot_retorno+="Disco: <code>$(html_escape "$disk")</code>\n"
    bot_retorno+="TeleBotGen: <b>$(html_escape "$bot_state")</b>\n"
    bot_retorno+="License API: <b>${api}</b>\n"
    bot_retorno+="$LINE"
    msj_fun
}
