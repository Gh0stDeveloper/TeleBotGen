#!/usr/bin/env bash
# Generación de licencias mediante GhostDeveloperLicenseServer.

resolve_key_target() {
    local requested="${comando[2]:-}" target
    if [[ "$requested" =~ ^[0-9]+$ ]]; then
        target="$requested"
    elif [[ "${reply_user_id:-}" =~ ^[0-9]+$ ]]; then
        target="$reply_user_id"
    else
        target="$actor_id"
    fi
    printf '%s' "$target"
}

resolve_key_username() {
    local requested="${comando[3]:-}" value
    if [[ -n "$requested" ]]; then
        value="$requested"
    elif [[ -n "${reply_username:-}" ]]; then
        value="$reply_username"
    else
        value="${actor_username:-}"
    fi
    value="${value#@}"
    value="$(tr -cd 'A-Za-z0-9_.-' <<< "$value")"
    printf '%s' "${value:0:64}"
}

gerar_key() {
    local minutes="${comando[1]:-240}" owner_id username response key expires_at license_id
    local install_command upgrade_command delivery_text confirmation

    if ! role_can_generate "$actor_role"; then
        bot_retorno="$LINE\nTu rol no permite generar licencias.\n$LINE"
        msj_fun
        return 0
    fi
    if ! role_validate_duration "$actor_role" "$minutes"; then
        bot_retorno="$LINE\nDuración inválida. Usa minutos enteros. Límite de revendedor: ${RESELLER_MAX_MINUTES} minutos.\n$LINE"
        msj_fun
        return 0
    fi

    owner_id="$(resolve_key_target)"
    username="$(resolve_key_username)"
    response="$(license_api_create "$minutes" "$owner_id" "$username" "$actor_id" "$actor_role" "$current_chat_id" 2>/dev/null || true)"
    if [[ -z "$response" ]] || ! jq empty <<< "$response" >/dev/null 2>&1; then
        bot_retorno="$LINE\nLa API no pudo crear la licencia. Revisa /api y los logs del servidor.\n$LINE"
        msj_fun
        return 1
    fi

    key="$(jq -r '.key // empty' <<< "$response")"
    expires_at="$(jq -r '.expires_at // empty' <<< "$response")"
    license_id="$(jq -r '.id // empty' <<< "$response")"
    [[ -n "$key" && -n "$license_id" ]] || {
        bot_retorno="$LINE\nLa API devolvió una licencia incompleta.\n$LINE"
        msj_fun
        return 1
    }

    install_command="$(html_escape "$(hextunnel_install_command)")"
    upgrade_command="$(html_escape "$(hextunnel_upgrade_command)")"
    delivery_text="<b>HEX TUNNEL — LICENCIA CREADA</b>\n$LINE\n"
    delivery_text+="Cliente: <code>${owner_id}</code>\n"
    delivery_text+="Duración: <b>$(license_human_duration "$((minutes*60))")</b>\n"
    delivery_text+="Vence: <code>$(html_escape "$expires_at")</code>\n"
    delivery_text+="ID interno: <code>$(html_escape "$license_id")</code>\n"
    delivery_text+="$LINE\n"
    delivery_text+="Key:\n<code>$(html_escape "$key")</code>\n"
    delivery_text+="$LINE\n"
    delivery_text+="Instalación:\n<code>${install_command}</code>\n"
    delivery_text+="$LINE\n"
    delivery_text+="Actualización posterior:\n<code>${upgrade_command}</code>\n"
    delivery_text+="Estado local: <code>sudo hextunnel-license status</code>\n"
    delivery_text+="$LINE\n"
    delivery_text+="Instala Hex Tunnel exclusivamente en una VPS dedicada Debian 12 o Ubuntu 22.04/24.04 amd64/x86_64.\n"
    delivery_text+="Desarrolladores: @Gh0stDeveloper · @Jotchua_DevzZ\n"
    delivery_text+="$LINE"

    if [[ "$current_chat_type" == group ]]; then
        send_to_actor "$delivery_text"
        confirmation="<b>Licencia generada.</b> Los datos privados fueron enviados al administrador/revendedor que ejecutó el comando. Cliente: <code>${owner_id}</code>."
        send_html "$current_chat_id" "$confirmation"
    else
        bot_retorno="$delivery_text"
        msj_fun
    fi
}
