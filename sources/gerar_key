#!/usr/bin/env bash
# Generación de códigos de activación transferibles.

self_service_username() {
    local value="${actor_username:-}"
    value="${value#@}"
    value="$(tr -cd 'A-Za-z0-9_.-' <<< "$value")"
    printf '%s' "${value:0:64}"
}

gerar_key() {
    local minutes owner_id username issuer_id issuer_role source_chat notification_chat
    local reseller_name response key expires_at license_id link_response installer_url link_expires
    local install_command delivery_text

    if ! keygen_context_allowed "$current_chat_type" "$current_chat_id" "$actor_role"; then
        bot_retorno="🚫 <b>Acceso no disponible</b>\n\nEsta función requiere acceso autorizado. Consulta <code>/help</code>."
        msj_fun
        return 0
    fi

    if ((${#comando[@]} > 1)); then
        bot_retorno="⚠️ <b>Comando incorrecto</b>\n\nUsa únicamente <code>/Keygen</code>."
        msj_fun
        return 0
    fi

    owner_id="$actor_id"
    username="$(self_service_username)"
    minutes="$(key_duration_get)"
    source_chat="$current_chat_id"

    if [[ "$current_chat_type" == group ]]; then
        issuer_id="$actor_id"
        issuer_role='allowed-group-member'
        notification_chat="$current_chat_id"
        reseller_name="$(group_reseller_name_get "$current_chat_id")"
    else
        issuer_id="$actor_id"
        issuer_role="$actor_role"
        notification_chat="$actor_id"
        reseller_name="$(reseller_name_get "$actor_id")"
    fi

    response="$(license_api_create \
        "$minutes" "$owner_id" "$username" "$issuer_id" "$issuer_role" \
        "$source_chat" "$notification_chat" "$reseller_name" 2>/dev/null || true)"
    if [[ -z "$response" ]] || ! jq empty <<< "$response" >/dev/null 2>&1; then
        bot_retorno="❌ <b>No se pudo generar la key</b>\n\nInténtalo nuevamente en unos momentos."
        msj_fun
        return 1
    fi

    key="$(jq -r '.key // empty' <<< "$response")"
    expires_at="$(jq -r '.expires_at // empty' <<< "$response")"
    license_id="$(jq -r '.id // empty' <<< "$response")"
    [[ -n "$key" && -n "$expires_at" && -n "$license_id" ]] || {
        bot_retorno="❌ <b>No se pudo completar la solicitud</b>"
        msj_fun
        return 1
    }

    link_response="$(license_api_create_installer_link "$actor_id" "$current_chat_id" 2>/dev/null || true)"
    installer_url="$(jq -r '.url // empty' <<< "$link_response" 2>/dev/null || true)"
    link_expires="$(jq -r '.expires_at // empty' <<< "$link_response" 2>/dev/null || true)"
    if [[ -z "$installer_url" ]]; then
        license_api_revoke "$license_id" "No se pudo crear el enlace temporal de instalación" >/dev/null 2>&1 || true
        bot_retorno="❌ <b>No se pudo crear el enlace temporal</b>\n\nLa key fue anulada automáticamente."
        msj_fun
        return 1
    fi

    issued_key_store "$license_id" "$key" "$expires_at" || {
        license_api_revoke "$license_id" "No se pudo registrar localmente la key para notificación" >/dev/null 2>&1 || true
        bot_retorno="❌ <b>No se pudo guardar la key de forma segura</b>"
        msj_fun
        return 1
    }

    install_command="$(html_escape "$(hextunnel_install_command "$installer_url")")"
    delivery_text="🎟️ <b>NUEVA KEY GENERADA</b>\n"
    delivery_text+="━━━━━━━━━━━━━━━━━━━━\n"
    delivery_text+="🔑 <b>Key</b>\n<code>$(html_escape "$key")</code>\n\n"
    delivery_text+="⏳ <b>Disponible para activarse durante:</b> $(license_human_duration "$((minutes*60))")\n"
    delivery_text+="📅 <b>Vence sin usar:</b> <code>$(html_escape "$expires_at")</code>\n"
    delivery_text+="🏷️ <b>Reseller:</b> $(html_escape "$reseller_name")\n\n"
    delivery_text+="🔗 <b>Enlace temporal del instalador</b>\n"
    delivery_text+="<a href=\"$(html_escape "$installer_url")\">Abrir instalador</a>\n"
    delivery_text+="Caduca: <code>$(html_escape "$link_expires")</code>\n\n"
    delivery_text+="💻 <b>Comando de instalación</b>\n<code>${install_command}</code>\n"
    delivery_text+="━━━━━━━━━━━━━━━━━━━━\n"
    delivery_text+="✅ La key puede entregarse a otra persona.\n"
    delivery_text+="♾️ Una vez activada correctamente, la instalación permanece activa hasta que sea revocada."

    bot_retorno="$delivery_text"
    msj_fun
}
