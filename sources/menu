#!/usr/bin/env bash

menu_src() {
    local used generator_status
    used="$(grep -c "^${chatuser}$" /etc/http-instas 2>/dev/null || true)"
    [[ "$used" =~ ^[0-9]+$ ]] || used=0

    if systemctl is-active --quiet hexgen-http.service; then
        generator_status='ONLINE'
    else
        generator_status='OFFLINE'
    fi

    bot_retorno="<b>HEX TUNNEL — PANEL</b>\n"
    bot_retorno+="$LINE\n"
    bot_retorno+="Activaciones usadas: <b>${used}</b>\n"

    if ! grep -Fxq "$chatuser" <<< "$permited"; then
        if ! grep -Fxq "$chatuser" "$CID" 2>/dev/null; then
            bot_retorno+="$LINE\n"
            bot_retorno+="/ID — mostrar tu ID de Telegram\n"
            bot_retorno+="/menu — abrir este panel\n"
            bot_retorno+="/ayuda — instrucciones\n"
            bot_retorno+="$LINE"
            msj_fun
        else
            bot_retorno+="$LINE\n"
            bot_retorno+="/keygen — generar una key de un solo uso\n"
            bot_retorno+="/install — mostrar el instalador RC\n"
            bot_retorno+="/ID — mostrar tu ID\n"
            bot_retorno+="/menu — abrir este panel\n"
            bot_retorno+="$LINE"
            menu_print
        fi
    else
        bot_retorno+="Servidor de validación: <b>${generator_status}</b>\n"
        bot_retorno+="$LINE\n"
        bot_retorno+="/keygen — generar una key\n"
        bot_retorno+="/install — comando de instalación\n"
        bot_retorno+="/power — iniciar o detener validación\n"
        bot_retorno+="/list — IDs autorizados\n"
        bot_retorno+="/add — autorizar ID\n"
        bot_retorno+="/del — revocar ID\n"
        bot_retorno+="/infosys — estado del VPS\n"
        bot_retorno+="/cache — limpiar caché RAM\n"
        bot_retorno+="/update — actualizar el bot\n"
        bot_retorno+="/reboot — reiniciar el VPS\n"
        bot_retorno+="$LINE"
        menu_print
    fi
}
