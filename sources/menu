#!/usr/bin/env bash

menu_src() {
    local expires_at remaining status bound_ip api_status duration_minutes
    bot_retorno="<b>HEX TUNNEL</b>\n"
    bot_retorno+="Desarrolladores: <a href=\"https://t.me/Gh0stDeveloper\">@Gh0stDeveloper</a> · <a href=\"https://t.me/Jotchua_DevzZ\">@Jotchua_DevzZ</a>\n"
    bot_retorno+="$LINE\n"

    if [[ "$current_chat_type" == group ]]; then
        duration_minutes="$(key_duration_get)"
        bot_retorno+="<b>GRUPO AUTORIZADO</b>\n"
        bot_retorno+="Todos los miembros pueden generar su propia key.\n"
        bot_retorno+="Comando: <code>/Keygen</code>\n"
        bot_retorno+="Duración: <b>$(license_human_duration "$((duration_minutes*60))")</b>\n"
        bot_retorno+="El bot obtiene automáticamente el Telegram ID del usuario que envía el comando.\n"
        bot_retorno+="La key y el instalador se entregan por mensaje privado.\n"
        bot_retorno+="$LINE"
        menu_print
        return 0
    fi

    case "$actor_role" in
        client)
            expires_at="$(jq -r '.expires_at // empty' <<< "$actor_license_json")"
            status="$(jq -r '.status // "desconocido"' <<< "$actor_license_json")"
            bound_ip="$(jq -r '.bound_ip // "sin activar"' <<< "$actor_license_json")"
            remaining="$(license_human_duration "$(license_remaining_seconds "$expires_at")")"
            bot_retorno+="Rol: <b>CLIENTE</b>\n"
            bot_retorno+="Acceso restante: <b>${remaining}</b>\n"
            bot_retorno+="Estado: <b>$(html_escape "$status")</b>\n"
            bot_retorno+="Vence: <code>$(html_escape "$expires_at")</code>\n"
            bot_retorno+="VPS vinculada: <code>$(html_escape "$bound_ip")</code>\n"
            bot_retorno+="$LINE\n"
            bot_retorno+="Hex Tunnel debe instalarse en una VPS dedicada amd64/x86_64.\n"
            ;;
        reseller)
            duration_minutes="$(key_duration_get)"
            bot_retorno+="Rol: <b>REVENDEDOR</b>\n"
            bot_retorno+="Tu propia key se genera con <code>/Keygen</code>.\n"
            bot_retorno+="Duración global: <b>$(license_human_duration "$((duration_minutes*60))")</b>\n"
            bot_retorno+="$LINE\n"
            bot_retorno+="En los grupos autorizados, cada miembro genera su propia key.\n"
            ;;
        admin)
            api_status='OFFLINE'
            license_api_health >/dev/null 2>&1 && api_status='ONLINE'
            duration_minutes="$(key_duration_get)"
            bot_retorno+="Rol: <b>ADMINISTRADOR</b>\n"
            bot_retorno+="API de licencias: <b>${api_status}</b>\n"
            bot_retorno+="Duración de nuevas keys: <b>$(license_human_duration "$((duration_minutes*60))")</b>\n"
            bot_retorno+="Chat actual: <code>$(html_escape "$current_chat_id")</code>\n"
            bot_retorno+="$LINE\n"
            bot_retorno+="Administración: /Setkeytime, /licenses, /revoke, /reset, /addreseller, /allowgroup y /api.\n"
            ;;
        *)
            duration_minutes="$(key_duration_get)"
            bot_retorno+="Genera tu propia key usando solamente <code>/Keygen</code>.\n"
            bot_retorno+="El bot detectará automáticamente tu Telegram ID.\n"
            bot_retorno+="Duración configurada: <b>$(license_human_duration "$((duration_minutes*60))")</b>\n"
            bot_retorno+="Información pública: <a href=\"https://ghostdeveloper.duckdns.org/\">ghostdeveloper.duckdns.org</a>\n"
            ;;
    esac

    bot_retorno+="$LINE"
    menu_print
}

license_status_src() {
    local license_json expires_at remaining status bound_ip private_text
    license_json="${actor_license_json:-}"
    if [[ -z "$license_json" || "$license_json" == null ]]; then
        license_json="$(license_api_active_for_owner "$actor_id" 2>/dev/null || true)"
    fi
    if [[ -z "$license_json" || "$license_json" == null ]]; then
        bot_retorno="$LINE\nNo tienes una licencia activa de Hex Tunnel. Usa /Keygen para generar la tuya.\n$LINE"
        msj_fun
        return 0
    fi
    expires_at="$(jq -r '.expires_at' <<< "$license_json")"
    remaining="$(license_human_duration "$(license_remaining_seconds "$expires_at")")"
    status="$(jq -r '.status' <<< "$license_json")"
    bound_ip="$(jq -r '.bound_ip // "sin activar"' <<< "$license_json")"
    private_text="<b>MI LICENCIA HEX TUNNEL</b>\n$LINE\n"
    private_text+="Tiempo restante: <b>${remaining}</b>\n"
    private_text+="Estado: <b>$(html_escape "$status")</b>\n"
    private_text+="Vence: <code>$(html_escape "$expires_at")</code>\n"
    private_text+="IP: <code>$(html_escape "$bound_ip")</code>\n"
    private_text+="$LINE"

    if [[ "$current_chat_type" == group ]]; then
        if send_html "$actor_id" "$(printf '%b' "$private_text")"; then
            send_html "$current_chat_id" "El estado de tu licencia fue enviado por privado."
        else
            send_html "$current_chat_id" "No pude enviarte el estado por privado. Abre el bot, ejecuta /start y vuelve a intentarlo."
        fi
    else
        bot_retorno="$private_text"
        msj_fun
    fi
}
