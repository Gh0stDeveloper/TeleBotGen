#!/usr/bin/env bash

menu_src() {
    local duration_minutes reseller_name role_label greeting
    duration_minutes="$(key_duration_get)"
    greeting="$(html_escape "${actor_username:+@$actor_username}")"
    [[ -n "$greeting" ]] || greeting="usuario <code>$(html_escape "$actor_id")</code>"

    bot_retorno="🚀 <b><a href=\"${HEXTUNNEL_PUBLIC_URL}\">HEX TUNNEL BOT GEN</a></b>\n"
    bot_retorno+="━━━━━━━━━━━━━━━━━━━━\n"
    bot_retorno+="👋 Hola, ${greeting}.\n\n"

    if [[ "$current_chat_type" == group ]]; then
        reseller_name="$(group_reseller_name_get "$current_chat_id")"
        if group_is_allowed "$current_chat_id"; then
            bot_retorno+="✅ <b>GRUPO AUTORIZADO</b>\n"
            bot_retorno+="🏷️ Reseller: <b>$(html_escape "$reseller_name")</b>\n"
            bot_retorno+="⏳ Tiempo para usar una key: <b>$(license_human_duration "$((duration_minutes*60))")</b>\n\n"
            bot_retorno+="🎟️ <code>/Keygen</code> — generar una key transferible\n"
            bot_retorno+="📖 <code>/help</code> — ver comandos disponibles\n"
            bot_retorno+="🆔 <code>/id</code> — mostrar IDs\n\n"
            bot_retorno+="La key y el enlace temporal se publican en este grupo. Cuando sea utilizada, el aviso también llegará aquí."
        else
            bot_retorno+="🔒 <b>Grupo sin autorización</b>\n\nUn administrador o revendedor puede habilitarlo con <code>/allowgroup</code>."
        fi
        menu_print
        return 0
    fi

    case "$actor_role" in
        admin) role_label='ADMINISTRADOR' ;;
        reseller) role_label='REVENDEDOR' ;;
        client) role_label='CLIENTE AUTORIZADO' ;;
        *) role_label='VISITANTE' ;;
    esac
    bot_retorno+="👤 Rol: <b>${role_label}</b>\n"

    if [[ "$actor_role" == public ]]; then
        bot_retorno+="\n🔒 Tu cuenta todavía no tiene acceso para generar keys.\n"
        bot_retorno+="🌐 <a href=\"${HEXTUNNEL_PUBLIC_URL}\">Sitio público de Hex Tunnel</a>\n\n"
        bot_retorno+="Comandos disponibles:\n<code>/start</code> · <code>/help</code> · <code>/id</code>"
    else
        reseller_name="$(reseller_name_get "$actor_id")"
        bot_retorno+="🏷️ Reseller: <b>$(html_escape "$reseller_name")</b>\n"
        bot_retorno+="⏳ Tiempo para usar cada key: <b>$(license_human_duration "$((duration_minutes*60))")</b>\n\n"
        if [[ "$reseller_name" == "$DEFAULT_RESELLER_NAME" ]]; then
            bot_retorno+="💡 No configuraste un reseller personalizado. Usa:\n<code>/setreseller Tu nombre</code>\n\n"
        fi
        bot_retorno+="🎟️ <code>/Keygen</code> — nueva key transferible\n"
        bot_retorno+="🏷️ <code>/reseller</code> — consultar reseller\n"
        bot_retorno+="📋 <code>/mykeys</code> — tus keys generadas\n"
        bot_retorno+="🔗 <code>/install</code> — enlace temporal\n"
        bot_retorno+="📖 <code>/help</code> — todos tus comandos\n"
    fi

    bot_retorno+="\n━━━━━━━━━━━━━━━━━━━━"
    menu_print
}

license_status_src() {
    local data total reseller_name
    if [[ "$actor_role" == public ]]; then
        bot_retorno="🔒 <b>Sin acceso autorizado</b>\n\nTu cuenta no puede generar keys por privado."
        msj_fun
        return 0
    fi
    data="$(license_api_for_issuer "$actor_id" 2>/dev/null || true)"
    total="$(jq -r '.total // 0' <<< "$data" 2>/dev/null || printf 0)"
    reseller_name="$(reseller_name_get "$actor_id")"
    bot_retorno="👤 <b>MI PERFIL</b>\n━━━━━━━━━━━━━━━━━━━━\n"
    bot_retorno+="Rol: <b>$(html_escape "$actor_role")</b>\n"
    bot_retorno+="Reseller: <b>$(html_escape "$reseller_name")</b>\n"
    bot_retorno+="Keys generadas: <code>${total}</code>\n\n"
    bot_retorno+="Una key vence únicamente si no fue utilizada dentro del tiempo configurado. Una instalación ya activada permanece activa hasta su revocación."
    msj_fun
}
