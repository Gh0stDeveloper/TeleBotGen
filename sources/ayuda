#!/usr/bin/env bash

ayuda_src() {
    local duration_minutes
    duration_minutes="$(key_duration_get)"
    bot_retorno="📖 <b>COMANDOS DISPONIBLES</b>\n━━━━━━━━━━━━━━━━━━━━\n"
    bot_retorno+="<code>/start</code> — abrir el menú\n"
    bot_retorno+="<code>/help</code> — mostrar esta ayuda\n"
    bot_retorno+="<code>/id</code> — consultar tu ID y el del chat\n"

    if [[ "$current_chat_type" == group ]]; then
        if group_is_allowed "$current_chat_id"; then
            bot_retorno+="<code>/Keygen</code> — generar una key transferible\n"
            bot_retorno+="<code>/install</code> — crear un enlace temporal\n"
            bot_retorno+="<code>/upgrade</code> — comando de actualización\n"
            if [[ "$actor_role" == admin || "$actor_role" == reseller ]]; then
                bot_retorno+="<code>/allowgroup</code> — reasignar este grupo a tu reseller\n"
                bot_retorno+="<code>/delgroup</code> — retirar este grupo\n"
            fi
        else
            bot_retorno+="\n🔒 Este grupo todavía no está autorizado."
            if [[ "$actor_role" == admin || "$actor_role" == reseller ]]; then
                bot_retorno+="\n<code>/allowgroup</code> — autorizarlo con tu reseller"
            fi
        fi
        bot_retorno+="\n━━━━━━━━━━━━━━━━━━━━"
        msj_fun
        return 0
    fi

    case "$actor_role" in
        client|reseller|admin)
            bot_retorno+="<code>/Keygen</code> — generar una key transferible\n"
            bot_retorno+="<code>/mykeys</code> — consultar tus keys\n"
            bot_retorno+="<code>/license</code> — ver tu perfil\n"
            bot_retorno+="<code>/reseller</code> — mostrar tu reseller\n"
            bot_retorno+="<code>/setreseller Nombre</code> — cambiar tu reseller\n"
            bot_retorno+="<code>/install</code> — enlace temporal del instalador\n"
            bot_retorno+="<code>/upgrade</code> — actualización de una instalación\n"
            ;;
    esac

    if [[ "$actor_role" == reseller || "$actor_role" == admin ]]; then
        bot_retorno+="\n👥 <b>GESTIÓN DE ACCESO</b>\n"
        bot_retorno+="<code>/addclient ID</code> · <code>/delclient ID</code>\n"
        bot_retorno+="<code>/clients</code> — listar clientes\n"
        bot_retorno+="<code>/allowgroup [ID]</code> · <code>/delgroup [ID]</code>\n"
        bot_retorno+="<code>/groups</code> — listar grupos\n"
    fi

    if [[ "$actor_role" == admin ]]; then
        bot_retorno+="\n🛡️ <b>ADMINISTRACIÓN</b>\n"
        bot_retorno+="<code>/Keytime</code> · <code>/Setkeytime minutos</code>\n"
        bot_retorno+="<code>/licenses [telegram_id]</code>\n"
        bot_retorno+="<code>/revoke license_id motivo</code>\n"
        bot_retorno+="<code>/reset license_id motivo</code>\n"
        bot_retorno+="<code>/addreseller ID</code> · <code>/delreseller ID</code>\n"
        bot_retorno+="<code>/resellers</code> · <code>/service</code> · <code>/update</code>\n"
    fi

    if [[ "$actor_role" == public ]]; then
        bot_retorno+="\n🔒 Tu cuenta aún no tiene acceso para generar keys por privado."
    else
        bot_retorno+="\n⏳ Las keys sin usar vencen en <b>$(license_human_duration "$((duration_minutes*60))")</b>."
        bot_retorno+="\n♾️ Una activación completada permanece activa hasta su revocación."
    fi
    bot_retorno+="\n━━━━━━━━━━━━━━━━━━━━\n🌐 <a href=\"${HEXTUNNEL_PUBLIC_URL}\">Hex Tunnel</a>"
    msj_fun
}
