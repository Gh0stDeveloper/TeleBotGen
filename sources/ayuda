#!/usr/bin/env bash

ayuda_src() {
    local is_admin=0 is_allowed=0
    grep -Fxq "$chatuser" <<< "$permited" && is_admin=1
    grep -Fxq "$chatuser" "$CID" 2>/dev/null && is_allowed=1

    bot_retorno="<b>HEX TUNNEL — AYUDA</b>\n"
    bot_retorno+="$LINE\n"
    bot_retorno+="/ID — muestra tu ID de Telegram.\n"
    bot_retorno+="/menu — abre el panel disponible para tu cuenta.\n"
    bot_retorno+="/ayuda — muestra estas instrucciones.\n"

    if ((is_admin == 1 || is_allowed == 1)); then
        bot_retorno+="$LINE\n"
        bot_retorno+="/keygen — genera una key criptográfica de un solo uso.\n"
        bot_retorno+="/install — muestra el comando del instalador Hex Tunnel RC.\n"
        bot_retorno+="La key se solicita antes del selector de módulos, caduca en cuatro horas y se consume al activarse.\n"
    else
        bot_retorno+="$LINE\n"
        bot_retorno+="Envía tu ID al administrador del bot para solicitar acceso a /keygen.\n"
    fi

    if ((is_admin == 1)); then
        bot_retorno+="$LINE\n"
        bot_retorno+="/add — autoriza un ID. También puede responderse al mensaje forzado.\n"
        bot_retorno+="/del — revoca un ID autorizado.\n"
        bot_retorno+="/list — muestra y exporta la lista de IDs.\n"
        bot_retorno+="/power — inicia o detiene el servidor de validación.\n"
        bot_retorno+="/infosys — muestra el estado del VPS.\n"
        bot_retorno+="/cache — libera caché de páginas del sistema.\n"
        bot_retorno+="/update — actualiza TeleBotGen desde el repositorio configurado.\n"
        bot_retorno+="/reboot — reinicia el VPS.\n"
    fi

    bot_retorno+="$LINE"
    msj_fun
}
