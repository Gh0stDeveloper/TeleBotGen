#!/usr/bin/env bash
# Administración pública-segura de accesos, grupos, keys y reseller.

join_command_from() {
    local start="$1" index output=''
    for ((index=start; index<${#comando[@]}; index++)); do
        [[ -z "$output" ]] || output+=' '
        output+="${comando[$index]}"
    done
    printf '%s' "$output"
}

access_service_status() {
    if license_api_health >/dev/null 2>&1; then
        bot_retorno="🟢 <b>Servicio disponible</b>\n\nLas funciones de generación y activación están operativas."
    else
        bot_retorno="🔴 <b>Servicio temporalmente no disponible</b>\n\nInténtalo nuevamente más tarde."
    fi
    msj_fun
}

access_show_key_duration() {
    local minutes
    minutes="$(key_duration_get)"
    bot_retorno="⏳ <b>TIEMPO PARA USAR UNA KEY</b>\n━━━━━━━━━━━━━━━━━━━━\n"
    bot_retorno+="Duración actual: <b>$(license_human_duration "$((minutes*60))")</b>\n"
    bot_retorno+="Valor: <code>${minutes} minutos</code>\n\n"
    bot_retorno+="Este tiempo solo limita una key que todavía no ha sido utilizada. Una instalación activada correctamente permanece activa hasta su revocación.\n\n"
    bot_retorno+="Cambiar: <code>/Setkeytime minutos</code>"
    msj_fun
}

access_set_key_duration() {
    local minutes="${comando[1]:-}"
    if ((${#comando[@]} != 2)) || ! valid_key_duration "$minutes"; then
        bot_retorno="⚠️ <b>Uso correcto</b>\n<code>/Setkeytime minutos</code>\n\nRango: 1 a 525600 minutos."
        msj_fun
        return 0
    fi
    key_duration_set "$minutes" || {
        bot_retorno="❌ No se pudo guardar el nuevo tiempo."
        msj_fun
        return 1
    }
    bot_retorno="✅ <b>Tiempo actualizado</b>\n\nLas nuevas keys podrán utilizarse durante <b>$(license_human_duration "$((minutes*60))")</b>."
    msj_fun
}

format_license_lines() {
    local json="$1" output='' count=0 license_id prefix status expires reseller activated label
    while IFS=$'\t' read -r license_id prefix status expires activated reseller; do
        [[ -n "$license_id" ]] || continue
        case "$status" in
            activated) label='✅ activada' ;;
            revoked) label='🚫 revocada' ;;
            expired) label='⌛ vencida sin usar' ;;
            *) label='🎟️ disponible' ;;
        esac
        output+="<code>$(html_escape "$license_id")</code>\n"
        output+="Key: <code>$(html_escape "$prefix")…</code> · ${label}\n"
        output+="Reseller: $(html_escape "$reseller")\n"
        if [[ -n "$activated" ]]; then
            output+="Activada: <code>$(html_escape "$activated")</code>\n\n"
        else
            output+="Vence sin usar: <code>$(html_escape "$expires")</code>\n\n"
        fi
        count=$((count+1))
        ((count >= 20)) && break
    done < <(jq -r '.[] | [.id,.key_prefix,.status,.expires_at,(.activated_at // ""),(.reseller_name // "Hex Tunnel Bot Gen")] | @tsv' <<< "$json")
    [[ -n "$output" ]] && printf '%s' "$output" || printf 'No hay keys para mostrar.\n'
}

access_list_licenses() {
    local data items owner_filter="${comando[1]:-}"
    if [[ "$owner_filter" =~ ^[0-9]+$ ]]; then
        data="$(license_api_for_owner "$owner_filter" 2>/dev/null || true)"
    else
        data="$(license_api_page 0 200 2>/dev/null || true)"
    fi
    [[ -n "$data" ]] || { bot_retorno="❌ No se pudo consultar la información."; msj_fun; return 1; }
    items="$(jq -c '.items // []' <<< "$data")"
    bot_retorno="🎫 <b>KEYS REGISTRADAS</b>\n━━━━━━━━━━━━━━━━━━━━\n$(format_license_lines "$items")"
    msj_fun
}

access_mykeys() {
    local data items
    data="$(license_api_for_issuer "$actor_id" 2>/dev/null || true)"
    [[ -n "$data" ]] || { bot_retorno="❌ No se pudo consultar tus keys."; msj_fun; return 1; }
    items="$(jq -c '.items // []' <<< "$data")"
    bot_retorno="🎟️ <b>MIS KEYS GENERADAS</b>\n━━━━━━━━━━━━━━━━━━━━\n$(format_license_lines "$items")"
    msj_fun
}

access_set_reseller() {
    local name
    if [[ "$current_chat_type" != private ]]; then
        bot_retorno="🔒 Configura tu reseller por privado con <code>/setreseller nombre</code>."
        msj_fun
        return 0
    fi
    [[ "$actor_role" != public ]] || { bot_retorno="🚫 Esta opción requiere acceso autorizado."; msj_fun; return 0; }
    name="$(join_command_from 1)"
    if ! reseller_name_set "$actor_id" "$name"; then
        bot_retorno="⚠️ Usa <code>/setreseller Nombre público</code> con 2 a 64 caracteres."
        msj_fun
        return 0
    fi
    bot_retorno="✅ <b>Reseller guardado</b>\n\nLas próximas keys mostrarán: <b>$(html_escape "$(reseller_name_get "$actor_id")")</b>"
    msj_fun
}

access_show_reseller() {
    [[ "$actor_role" != public ]] || { bot_retorno="🚫 Esta opción requiere acceso autorizado."; msj_fun; return 0; }
    bot_retorno="🏷️ <b>TU RESELLER</b>\n\nNombre actual: <b>$(html_escape "$(reseller_name_get "$actor_id")")</b>\n\nCambiar: <code>/setreseller Nombre público</code>"
    msj_fun
}

access_add_reseller() {
    local target="${comando[1]:-${reply_user_id:-}}"
    [[ "$target" =~ ^[0-9]+$ ]] || { bot_retorno="⚠️ Usa <code>/addreseller telegram_id</code> o responde a un usuario."; msj_fun; return; }
    role_add_value "$RESELLER_FILE" "$target"
    role_remove_value "$CLIENT_FILE" "$target" >/dev/null 2>&1 || true
    bot_retorno="✅ Revendedor autorizado: <code>${target}</code>"
    msj_fun
    send_html "$target" "🎉 <b>Acceso de revendedor activado</b>\n\nAbre <code>/start</code> y configura tu nombre con <code>/setreseller Nombre</code>." || true
}

access_del_reseller() {
    local target="${comando[1]:-${reply_user_id:-}}"
    [[ "$target" =~ ^[0-9]+$ ]] || { bot_retorno="⚠️ Usa <code>/delreseller telegram_id</code>."; msj_fun; return; }
    role_remove_value "$RESELLER_FILE" "$target"
    bot_retorno="✅ Acceso de revendedor retirado: <code>${target}</code>"
    msj_fun
}

access_list_resellers() {
    local values
    values="$(awk 'NF {printf "<code>%s</code>\\n",$0}' "$RESELLER_FILE" 2>/dev/null || true)"
    bot_retorno="🏷️ <b>REVENDEDORES AUTORIZADOS</b>\n\n${values:-No hay revendedores.}"
    msj_fun
}

access_add_client() {
    local target="${comando[1]:-${reply_user_id:-}}"
    [[ "$target" =~ ^[0-9]+$ ]] || { bot_retorno="⚠️ Usa <code>/addclient telegram_id</code> o responde a un usuario."; msj_fun; return; }
    role_is_admin "$target" && { bot_retorno="ℹ️ Ese usuario ya es administrador."; msj_fun; return; }
    role_is_reseller "$target" && { bot_retorno="ℹ️ Ese usuario ya es revendedor."; msj_fun; return; }
    role_add_value "$CLIENT_FILE" "$target"
    bot_retorno="✅ Cliente autorizado: <code>${target}</code>"
    msj_fun
    send_html "$target" "🎉 <b>Acceso de cliente activado</b>\n\nAbre <code>/start</code>. Ya puedes generar keys y configurar tu reseller." || true
}

access_del_client() {
    local target="${comando[1]:-${reply_user_id:-}}"
    [[ "$target" =~ ^[0-9]+$ ]] || { bot_retorno="⚠️ Usa <code>/delclient telegram_id</code>."; msj_fun; return; }
    role_remove_value "$CLIENT_FILE" "$target"
    bot_retorno="✅ Acceso de cliente retirado: <code>${target}</code>"
    msj_fun
}

access_list_clients() {
    local values
    values="$(awk 'NF {printf "<code>%s</code>\\n",$0}' "$CLIENT_FILE" 2>/dev/null || true)"
    bot_retorno="👥 <b>CLIENTES AUTORIZADOS</b>\n\n${values:-No hay clientes.}"
    msj_fun
}

access_allow_group() {
    local target="${comando[1]:-$current_chat_id}"
    [[ "$target" =~ ^-[0-9]+$ ]] || { bot_retorno="⚠️ Ejecuta <code>/allowgroup</code> dentro del grupo o indica su ID negativo."; msj_fun; return; }
    role_add_value "$GROUP_FILE" "$target"
    group_owner_set "$target" "$actor_id"
    bot_retorno="✅ <b>Grupo autorizado</b>\n\nID: <code>${target}</code>\nReseller asignado: <b>$(html_escape "$(reseller_name_get "$actor_id")")</b>\n\nLos miembros podrán generar keys en este grupo."
    msj_fun
}

access_del_group() {
    local target="${comando[1]:-$current_chat_id}"
    [[ "$target" =~ ^-[0-9]+$ ]] || { bot_retorno="⚠️ Usa <code>/delgroup -100...</code>."; msj_fun; return; }
    role_remove_value "$GROUP_FILE" "$target"
    group_owner_remove "$target" || true
    bot_retorno="✅ Grupo retirado: <code>${target}</code>"
    msj_fun
}

access_list_groups() {
    local group owner values=''
    while IFS= read -r group; do
        [[ -n "$group" ]] || continue
        owner="$(group_owner_get "$group")"
        if [[ "$actor_role" == reseller && "$owner" != "$actor_id" ]]; then
            continue
        fi
        values+="<code>$(html_escape "$group")</code> · $(html_escape "$(group_reseller_name_get "$group")")\n"
    done < "$GROUP_FILE"
    bot_retorno="👥 <b>GRUPOS PERMITIDOS</b>\n\n${values:-No hay grupos para mostrar.}"
    msj_fun
}

access_revoke_license() {
    local license_id="${comando[1]:-}" reason response
    reason="$(join_command_from 2)"
    [[ -n "$reason" ]] || reason='Revocada por un administrador'
    response="$(license_api_revoke "$license_id" "$reason" 2>/dev/null || true)"
    [[ -n "$response" ]] || { bot_retorno="⚠️ Usa <code>/revoke license_id motivo</code>."; msj_fun; return 1; }
    issued_key_remove "$license_id" >/dev/null 2>&1 || true
    bot_retorno="🚫 Instalación/key revocada: <code>$(html_escape "$license_id")</code>"
    msj_fun
}

access_reset_license() {
    local license_id="${comando[1]:-}" reason response
    reason="$(join_command_from 2)"
    [[ -n "$reason" ]] || reason='Cambio autorizado de VPS'
    response="$(license_api_reset "$license_id" "$reason" 2>/dev/null || true)"
    [[ -n "$response" ]] || { bot_retorno="⚠️ Usa <code>/reset license_id motivo</code>."; msj_fun; return 1; }
    bot_retorno="✅ Activación reiniciada: <code>$(html_escape "$license_id")</code>"
    msj_fun
}
