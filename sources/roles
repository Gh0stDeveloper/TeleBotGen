#!/usr/bin/env bash
# Roles, grupos permitidos y configuración global de keys.

ADMIN_FILE="${TELEBOTGEN_ADMIN_FILE:-/etc/ADM-db/Admin-ID}"
RESELLER_FILE="${TELEBOTGEN_RESELLER_FILE:-/etc/ADM-db/Reseller-ID}"
GROUP_FILE="${TELEBOTGEN_GROUP_FILE:-/etc/ADM-db/Allowed-Groups}"
KEY_DURATION_FILE="${TELEBOTGEN_KEY_DURATION_FILE:-/etc/ADM-db/Key-Duration-Minutes}"
DEFAULT_KEY_DURATION_MINUTES="${TELEBOTGEN_DEFAULT_KEY_DURATION_MINUTES:-240}"

valid_key_duration() {
    local minutes="${1:-}"
    [[ "$minutes" =~ ^[0-9]+$ && "$minutes" -ge 1 && "$minutes" -le 525600 ]]
}

roles_prepare_files() {
    local file directory
    for file in "$ADMIN_FILE" "$RESELLER_FILE" "$GROUP_FILE"; do
        directory="$(dirname -- "$file")"
        install -d -m 700 "$directory"
        [[ -e "$file" ]] || : > "$file"
        chmod 600 "$file"
    done

    directory="$(dirname -- "$KEY_DURATION_FILE")"
    install -d -m 700 "$directory"
    if [[ ! -s "$KEY_DURATION_FILE" ]]; then
        valid_key_duration "$DEFAULT_KEY_DURATION_MINUTES" || DEFAULT_KEY_DURATION_MINUTES=240
        printf '%s\n' "$DEFAULT_KEY_DURATION_MINUTES" > "$KEY_DURATION_FILE"
    fi
    chmod 600 "$KEY_DURATION_FILE"
}

role_file_contains() {
    local file="$1" value="$2"
    [[ -n "$value" && -r "$file" ]] && grep -Fxq -- "$value" "$file"
}

role_is_admin() { role_file_contains "$ADMIN_FILE" "$1"; }
role_is_reseller() { role_file_contains "$RESELLER_FILE" "$1"; }

group_is_chat() { [[ "${1:-}" == -* ]]; }
group_is_allowed() { role_file_contains "$GROUP_FILE" "$1"; }

keygen_context_allowed() {
    local chat_type="${1:-}" chat_id="${2:-}"
    [[ "$chat_type" == private ]] || {
        [[ "$chat_type" == group ]] && group_is_allowed "$chat_id"
    }
}

key_duration_get() {
    local minutes
    minutes="$(tr -d '[:space:]' < "$KEY_DURATION_FILE" 2>/dev/null || true)"
    if ! valid_key_duration "$minutes"; then
        minutes="$DEFAULT_KEY_DURATION_MINUTES"
    fi
    valid_key_duration "$minutes" || minutes=240
    printf '%s' "$minutes"
}

key_duration_set() {
    local minutes="${1:-}" temporary
    valid_key_duration "$minutes" || return 1
    temporary="$(mktemp)"
    printf '%s\n' "$minutes" > "$temporary"
    install -m 600 "$temporary" "$KEY_DURATION_FILE"
    rm -f "$temporary"
}

actor_resolve_role() {
    local actor="$1"
    actor_license_json=''
    if role_is_admin "$actor"; then
        actor_role='admin'
    elif role_is_reseller "$actor"; then
        actor_role='reseller'
    else
        actor_license_json="$(license_api_active_for_owner "$actor" 2>/dev/null || true)"
        if [[ -n "$actor_license_json" && "$actor_license_json" != null ]]; then
            actor_role='client'
        else
            actor_role='public'
        fi
    fi
    export actor_role actor_license_json
}

role_add_value() {
    local file="$1" value="$2"
    [[ -n "$value" ]] || return 2
    role_file_contains "$file" "$value" || printf '%s\n' "$value" >> "$file"
    sort -u -o "$file" "$file"
    chmod 600 "$file"
}

role_remove_value() {
    local file="$1" value="$2" temporary
    [[ -n "$value" && -e "$file" ]] || return 2
    temporary="$(mktemp)"
    grep -Fvx -- "$value" "$file" > "$temporary" || true
    install -m 600 "$temporary" "$file"
    rm -f "$temporary"
}
